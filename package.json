{
  "name": "@tradingale/martingale-kit",
  "version": "0.1.0",
  "description": "The martingale sequence engine as a library: exact ladder math, one-active-sell state machine, directional grid snapping, paper simulator, Tradingale data client. Bring your own venue adapter.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/tradingale/martingale-kit.git"
  },
  "homepage": "https://tradingale.com/build",
  "keywords": [
    "martingale",
    "trading-data",
    "tradingale",
    "mcp",
    "paper-trading",
    "typescript"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "runner": "tsx src/runner/cli.ts",
    "server": "tsx src/server/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
